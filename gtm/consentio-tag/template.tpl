___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const url = 'https://cdn.jsdelivr.net/gh/ChrisMavrommatis/consentio@0.0.4/dist/consentio.min.js';
const log = require('logToConsole');
const injectScript = require('injectScript');
const callInWindow = require('callInWindow');
const setInWindow = require('setInWindow');
const copyFromWindow = require('copyFromWindow');
const Object = require('Object');

log('Consentio Tag =', data);

// ## Config Setup ##
function removeNullsOrEmtpyStrings(obj){
  for(const key in obj){
    const value = obj[key];
    if(value === null || value === undefined || value === ""){
      Object.delete(obj, key);
    }
  }
}

function hasSelectedVariable(obj){
  return obj !== 'none';
}

const hasTextsVariable = hasSelectedVariable(data.texts);
const hasCookiesVariable = hasSelectedVariable(data.cookies);

const config = {
  version: data.version,
  debug: data.debug,
  consentRequired: data.consentRequired,
  texts: {
    barTitle: hasTextsVariable ? data.texts.barTitle : null,
    barDescription: hasTextsVariable ? data.texts.barDescription : null,
    buttonSettings: hasTextsVariable ? data.texts.buttonSettings : null,
    buttonSave: hasTextsVariable ? data.texts.buttonSave: null,
    buttonCancel: hasTextsVariable ? data.texts.buttonCancel : null,
    buttonAcceptAll: hasTextsVariable ? data.texts.buttonAcceptAll : null,
    modalTitle: hasTextsVariable ? data.texts.modalTitle : null,
    modalDescription: hasTextsVariable ? data.texts.modalDescription : null,
    alwaysOnLabel: hasTextsVariable ? data.texts.alwaysOnLabel: null,
    cookieTableHeaderName: hasTextsVariable ? data.texts.cookieTableHeaderName : null,
    cookieTableHeaderPurpose: hasTextsVariable ? data.texts.cookieTableHeaderPurpose : null,
    cookieTableHeaderProvenance: hasTextsVariable ? data.texts.cookieTableHeaderProvenance : null,
    cookieTableHeaderDuration: hasTextsVariable ? data.texts.cookieTableHeaderDuration : null,
  },
  consents: [
    {
      key: 'strictly_necessary',
      title: hasTextsVariable ? data.texts.strictly_necessary.title : null,
      description: hasTextsVariable ? data.texts.strictly_necessary.description : null,
      alwaysOn: true,
      defaultState: 'granted'
    },
    {
      key: 'preferences_functionality',
      title: hasTextsVariable ? data.texts.preferences_functionality.title : null,
      description: hasTextsVariable ? data.texts.preferences_functionality.description : null,
      alwaysOn: false,
      defaultState: data.preferencesFunctionalityDefaultState
    },
    {
      key: 'statistics_performance',
      title: hasTextsVariable ? data.texts.statistics_performance.title : null,
      description: hasTextsVariable ? data.texts.statistics_performance.description : null,
      alwaysOn: false,
      defaultState: data.statisticsPerformanceDefaultState
    },
    {
       key: 'marketing_advertising',
       title: hasTextsVariable ? data.texts.marketing_advertising.title : null,
       description: hasTextsVariable ? data.texts.marketing_advertising.description : null,
       alwaysOn: false,
       defaultState: data.marketingAdvertisingDefaultState
    },
  ]
};
const cookies = hasCookiesVariable ? data.cookies : [];

removeNullsOrEmtpyStrings(config.texts);
for(const consent of config.consents){
  removeNullsOrEmtpyStrings(consent);
}

log('config =', config);
log('cookies =', cookies);


// ## load script ##

const scriptLoaded = function () {
  const consentioInstance = callInWindow('Consentio.Create', config, cookies);
  setInWindow('ConsentioIntance', consentioInstance);
};

const scriptNotLoaded = function () {
};

injectScript(url, scriptLoaded, scriptNotLoaded);

// Call data.gtmOnSuccess when the tag is finished.
data.gtmOnSuccess();


