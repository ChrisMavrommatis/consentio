{
	"compilerOptions": {
		// Anything lower downlevels the sources webpack otherwise passes through untouched.
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"strict": true,
		// Inert since consentio-loader.ts became a module and is strict either way.
		"alwaysStrict": false
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "website/scripts/**/*.ts", "test/**/*.mts"]
}
