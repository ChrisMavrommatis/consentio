{
  "name": "consentio",
  "version": "0.1.0",
  "description": "A small, frontend-only consent banner for static sites. Pushes Google Consent Mode signals to dataLayer and stores the answer in one cookie.",
  "scripts": {
    "build": "npx webpack --env build=lib",
    "build:website": "npx webpack --env build=website",
    "build:dist": "npx webpack --env build=dist",
    "typecheck": "npx tsc --noEmit",
    "test": "node --import ./test/register.mjs --test \"test/**/*.test.mts\"",
    "test:plain": "node --import ./test/register-plain.mjs --test \"test/lib/logger.test.mts\" \"test/lib/cookies/attributes.test.mts\" \"test/lib/cookies/read-write.test.mts\" \"test/lib/state/*.test.mts\" \"test/lib/gtm/*.test.mts\" \"test/lib/consent-signals/completeness.test.mts\" \"test/lib/consent-signals/signal-map.test.mts\" \"test/lib/consent-store/*.test.mts\"",
    "build:site": "npm run build:website && cd ./website && bundle exec jekyll build",
    "build:site:prod": "npm run build:website && cd ./website && bundle exec jekyll build --config _config.yml,_config.prod.yml",
    "watch": "npx webpack --watch --env build=website",
    "serve": "npm run build:website && cd ./website && bundle exec jekyll serve"
  },
  "keywords": [
    "consent",
    "cookies",
    "gdpr",
    "privacy",
    "modal",
    "compliance",
    "frontend",
    "vanilla-js"
  ],
  "author": "ChrisMavrommatis",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChrisMavrommatis/consentio.git"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "html-loader": "^5.1.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  }
}
